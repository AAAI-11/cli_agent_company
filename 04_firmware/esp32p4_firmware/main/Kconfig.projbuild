menu "PetLink"

    config PETLINK_GPIO_YES
        int "YES 按键 GPIO 编号"
        range 0 54
        default 50
        help
            YES 实体键（放行）：任意按下松开即放行，无时长判档
            （长按拒绝手势 v0.8 废除）。
            接法：按键一脚接该 GPIO，另一脚接 GND，内部上拉。
            默认 GPIO50 = 复刻底板 SW1（2026-09-12 三键改版）。
            杜邦线临时接线阶段可 menuconfig 改回
            （曾用 GPIO21 = 排针 27 脚，隔壁 28 脚即 GND）。

    config PETLINK_GPIO_NO
        int "NO 按键 GPIO 编号"
        range 0 54
        default 49
        help
            NO 实体键（拒绝）：按下即拒，不看时长——
            2026-09-03 真机两次没按准 600ms 长按，演示现场风险太大。
            接法同 YES：一脚接该 GPIO，另一脚接 GND（可与 YES 共用 GND）。
            默认 GPIO49 = 复刻底板 SW2（曾用 GPIO22 = 排针 29 脚）。

    config PETLINK_GPIO_VOICE
        int "VOICE 语音键 GPIO 编号（-1=无双键布局外的语音键）"
        range -1 54
        default 5
        help
            专用语音键：按住录音、松手上传（v0.8 三键改版，PTT）。
            只在空闲态生效——授权等待时语音让位给按键裁决
            （门控 main.c voice_armed）。
            默认 GPIO5 = 复刻底板 SW3。设 -1 退回双键布局
            （语音输入随之不可用）。

    config PETLINK_GPIO_JOY_X
        int "摇杆 X 轴 ADC GPIO 编号（-1=摇杆禁用）"
        range -1 54
        default 21
        help
            F17 摇杆导航（v3.5 宪法 §4.8）：复刻底板 5kΩ 自回中模拟
            摇杆，X 轴左右推 → prev/next 事件，daemon 侧双向切焦点
            会话 + tmux 视图同步。Y 轴与 SW 按下轴本期不接（实板读数：
            X=GPIO21 / Y=GPIO20，均 ADC1 空闲脚，记档备将来扩展）。
            默认 21 = 实板原理图读数；改 -1 可禁用。GPIO 必须是
            ADC 脚（ADC1/ADC2），运行时探测失败只禁用摇杆，
            不影响主链路。门控同语音输入：授权等待时让位、
            录音时不翻页、未握手不生效。

    menu "PetLink UI"

        config PETLINK_UI_STAGE
            int "UI 分阶段开发旋钮"
            range 0 3
            default 3
            help
                0=无屏模式（v0.1 行为，一键回退保险）。
                1=纯 esp_lcd 彩条（点亮验证，不起协议任务）。
                2=LVGL 接管显示静态测试页（不起协议任务）。
                3=正式：屏幕 UI + 协议任务（默认）。

        config PETLINK_UI_SELFTEST
            bool "UI 六态轮播自检（每 2 秒切换一态，不收协议输入）"
            default n
            help
                演示屏是否正常、中文标签是否缺字、动画是否在跑的
                快速体检开关。验收后必须关掉。

        config PETLINK_DSI_LDO_CHAN
            int "MIPI DSI PHY 电源 LDO 通道号"
            range 0 7
            default 3
            help
                ESP32-P4 内部可调 LDO 通道（EV 板参考=3，微雪板
                原理图未核实时先用默认，白屏/花屏再试 4）。

        config PETLINK_DSI_LDO_MV
            int "MIPI DSI PHY 电压（毫伏）"
            range 1200 3300
            default 2500
            help
                DPHY 需要独立的 2.5V 轨（EV 板参考值）。失败候选：
                1800 / 2800。

        config PETLINK_LCD_FLIP_180
            bool "屏幕 180° 翻转（物理反装补偿）"
            default y
            help
                复刻底板装配后屏物理朝向反了（2026-09-18 组装发现）。实现：
                pet_ui.c 的 raster 转置方向 CW→CCW（180° 反装在数学上等价
                于逆时针 90° 安装），纯下标翻转，零额外开销。曾试过面板级
                MADCTL(0x36)=0xC0 硬转，这块 WLK2802 不认（烧录实测），
                已从初始化序列撤除。正确安装的屏改 n 即回正向。

        config PETLINK_LCD_RST_GPIO
            int "LCD 复位脚 GPIO（-1=无 RST 脚，走软复位）"
            default -1
            help
                已核实（卖家模块图纸）：WLK2802MIPI-15P 的 FPC
                无 RESET 引脚，保持 -1，组件自动走 SWRESET 软复位。

        config PETLINK_UI_PNG
            bool "PNG 素材槽（asset 分区 FAT + lodepng）"
            default y
            help
                挂载 2MB asset 分区（FAT 长文件名），素材约定与
                virtual_device/assets/README.md 完全一致：五态各一张
                352×352 PNG（显示 176）。图在则替换矢量小狗（附件动画
                保留），挂载失败/缺图/解码失败一律回退矢量——演示
                永不断链。打包烧录：sh tools/mkassets.sh。

    endmenu

    menu "PetLink 状态提示音"

        config PETLINK_SPK_ENABLED
            bool "板载喇叭状态提示音（F16）"
            default y
            help
                waiting_confirm/done/error 状态转移时，经板载 ES8311 DAC +
                NS4150 功放（PA_Ctrl=GPIO53，外接 8Ω 无源喇叭）播放正弦
                合成提示音；与 daemon 侧 TTS（F12）同触发集。同状态重复
                帧不响；录音（F14）优先，mic 忙时提示音直接丢弃。硬件装配
                与录音共用 audio_hw.c 的 duplex I2S + 单颗 codec。

        config PETLINK_SPK_VOLUME
            int "提示音音量（ES8311 DAC 数字音量）"
            range 0 100
            default 80
            help
                NS4150 3W D 类增益不低，小喇叭 70 挺响；夜里编码可调 30。

    endmenu

    menu "PetLink 语音输入"

        config PETLINK_MIC_ENABLED
            bool "板载 ES8311 麦克风录音（语音输入）"
            default y
            help
                微雪 P4-WIFI6 板载模拟麦经 ES8311 codec（I²C 0x18）+
                I2S STD 采集（espressif/esp_codec_dev 官方音频栈），
                VOICE 键按住说话触发录音，audio 帧经 UART 上行给 daemon
                转 whisper。关掉则语音键无功能。

        config PETLINK_MIC_MAX_MS
            int "单次录音时长上限（毫秒）"
            range 2000 30000
            default 30000
            help
                按住说话（PTT）：松手即上传；按住超过上限自动截断并
                照常上传（v0.8 起不再定长录音）。
                16kHz×16bit = 32KB/s；30s ≈ 960KB（PSRAM 缓冲，
                32MB PSRAM 充裕），921600 波特率下上行约 10s。
                快于 500ms 的松手视为误触，本地丢弃。

        config PETLINK_MIC_GAIN_DB
            int "ES8311 麦克风模拟增益（dB）"
            range 0 42
            default 24
            help
                ES8311 PGA，驱动按 6dB 步进取整（0/6/…/42）。24dB 适合
                30cm 近讲；远场可试 30/36。引脚（I²C SCL=8/SDA=7，
                I2S MCLK=13/SCLK=12/LRCK=10/DIN=11）为板载固定布线，
                硬编码在 mic.c——微雪 wiki「I2S Audio Demo」核实。
                历史教训：v0.4.0/0.4.1 误信网上资料把 GPIO23/24 当
                PDM 直连麦，两槽皆精确零——此板根本没有 PDM 麦。

    endmenu

endmenu
